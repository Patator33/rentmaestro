# ─── Port & URL ───────────────────────────────────────────────────────────────
# Port exposé par le conteneur sur l'hôte (défaut : 3008)
PORT_EXTERNAL=3008

# URL publique de l'application — utilisée dans les emails, quittances, portail
APP_BASE_URL=https://rentmaestro.votredomaine.com

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre@gmail.com
SMTP_PASS=mot_de_passe_application
SMTP_FROM=votre@gmail.com

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Session iron-session — générer avec : node -e "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=CHANGEZ_MOI_PAR_UNE_CLE_DE_64_CARACTERES_ALEATOIRES

# Secret pour les routes CRON (ex. appel depuis n8n ou cron externe)
CRON_SECRET=remplacez_moi_par_un_vrai_secret

# ─── Intégrations ─────────────────────────────────────────────────────────────
# Webhook n8n pour les automatisations (optionnel)
N8N_WEBHOOK_URL=http://n8n.votredomaine.com/webhook/rentmaestro

# ─── Push notifications (VAPID) ───────────────────────────────────────────────
# Générer avec : node -e "require('web-push').generateVAPIDKeys()" | console.log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://rentmaestro.votredomaine.com

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Mettre à 'true' si derrière un reverse proxy HTTPS (obligatoire pour PWA Android)
# Mettre à 'false' pour un accès direct en HTTP (ex: http://ip:3008 en dev/test)
COOKIE_SECURE=true

# ─── Rapprochement automatique des virements ──────────────────────────────────
# Optionnels. Laissés vides, les routes /api/automation et le webhook Telegram
# restent fermés. 16 caractères minimum chacun, différents l'un de l'autre.
# Générer avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# Partagé avec n8n, qui l'envoie dans l'en-tête x-automation-secret
AUTOMATION_SECRET=
# Renvoyé par Telegram à chaque clic sur un bouton de validation
TELEGRAM_WEBHOOK_SECRET=
